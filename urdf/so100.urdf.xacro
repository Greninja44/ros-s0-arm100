<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="so100">

  <!-- ========================================================= -->
  <!-- Materials                                                  -->
  <!-- ========================================================= -->

  <material name="so100_gray">
    <color rgba="0.65 0.65 0.65 1.0"/>
  </material>

  <material name="so100_dark">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>


  <!-- ========================================================= -->
  <!-- BASE                                                       -->
  <!-- ========================================================= -->

  <link name="base">

    <!-- Main base -->
    <visual>
      <geometry>
        <mesh filename="package://so100_description/meshes/so100/Base.stl"/>
      </geometry>
      <material name="so100_gray"/>
    </visual>

    <!-- Base motor -->
    <visual>
      <geometry>
        <mesh filename="package://so100_description/meshes/so100/Base_Motor.stl"/>
      </geometry>
      <material name="so100_dark"/>
    </visual>

    <!-- Collision -->
    <collision>
      <geometry>
        <mesh filename="package://so100_description/meshes/so100/Base.stl"/>
      </geometry>
    </collision>

    <collision>
      <geometry>
        <mesh filename="package://so100_description/meshes/so100/Base_Motor.stl"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="0.01"
        ixy="0"
        ixz="0"
        iyy="0.01"
        iyz="0"
        izz="0.01"/>
    </inertial>

  </link>


  <!-- ========================================================= -->
  <!-- SHOULDER                                                   -->
  <!-- ========================================================= -->

  <link name="shoulder">

    <!-- Shoulder body -->
    <visual>
      <geometry>
        <mesh filename="package://so100_description/meshes/so100/Rotation_Pitch.stl"/>
      </geometry>
      <material name="so100_gray"/>
    </visual>

    <!-- Shoulder motor -->
    <visual>
      <geometry>
        <mesh filename="package://so100_description/meshes/so100/Rotation_Pitch_Motor.stl"/>
      </geometry>
      <material name="so100_dark"/>
    </visual>

    <!-- Collision -->
    <collision>
      <geometry>
        <mesh filename="package://so100_description/meshes/so100/Rotation_Pitch.stl"/>
      </geometry>
    </collision>

    <collision>
      <geometry>
        <mesh filename="package://so100_description/meshes/so100/Rotation_Pitch_Motor.stl"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.119226"/>
      <origin
        xyz="-9.07886e-05 0.0590972 0.031089"
        rpy="0 0 0"/>
      <inertia
        ixx="5.94278e-05"
        ixy="0"
        ixz="0"
        iyy="5.89975e-05"
        iyz="0"
        izz="3.13712e-05"/>
    </inertial>

  </link>


  <!-- ========================================================= -->
  <!-- SHOULDER PAN                                               -->
  <!-- ========================================================= -->

  <joint name="shoulder_pan" type="revolute">

    <parent link="base"/>
    <child link="shoulder"/>

    <origin
      xyz="0 -0.0452 0.0165"
      rpy="1.57079 0 0"/>

    <axis xyz="0 1 0"/>

    <limit
      lower="-2"
      upper="2"
      effort="35"
      velocity="1"/>

  </joint>


  <!-- ========================================================= -->
  <!-- UPPER ARM                                                  -->
  <!-- ========================================================= -->

  <link name="upper_arm">

    <!-- Upper arm body -->
    <visual>
      <geometry>
        <mesh filename="package://so100_description/meshes/so100/Upper_Arm.stl"/>
      </geometry>
      <material name="so100_gray"/>
    </visual>

    <!-- Upper arm motor -->
    <visual>
      <geometry>
        <mesh filename="package://so100_description/meshes/so100/Upper_Arm_Motor.stl"/>
      </geometry>
      <material name="so100_dark"/>
    </visual>

    <!-- Collision -->
    <collision>
      <geometry>
        <mesh filename="package://so100_description/meshes/so100/Upper_Arm.stl"/>
      </geometry>
    </collision>

    <collision>
      <geometry>
        <mesh filename="package://so100_description/meshes/so100/Upper_Arm_Motor.stl"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.162409"/>
      <origin
        xyz="-1.72052e-05 0.0701802 0.00310545"
        rpy="0 0 0"/>
      <inertia
        ixx="0.000213312"
        ixy="0"
        ixz="0"
        iyy="0.000167164"
        iyz="0"
        izz="7.01522e-05"/>
    </inertial>

  </link>


  <!-- ========================================================= -->
  <!-- SHOULDER LIFT                                              -->
  <!-- ========================================================= -->

  <joint name="shoulder_lift" type="revolute">

    <parent link="shoulder"/>
    <child link="upper_arm"/>

    <origin
      xyz="0 0.1025 0.0306"
      rpy="-1.8 0 0"/>

    <axis xyz="1 0 0"/>

    <limit
      lower="0"
      upper="3.5"
      effort="35"
      velocity="1"/>

  </joint>


  <!-- ========================================================= -->
  <!-- LOWER ARM                                                  -->
  <!-- ========================================================= -->

  <link name="lower_arm">

    <!-- Lower arm body -->
    <visual>
      <geometry>
        <mesh filename="package://so100_description/meshes/so100/Lower_Arm.stl"/>
      </geometry>
      <material name="so100_gray"/>
    </visual>

    <!-- Lower arm motor -->
    <visual>
      <geometry>
        <mesh filename="package://so100_description/meshes/so100/Lower_Arm_Motor.stl"/>
      </geometry>
      <material name="so100_dark"/>
    </visual>

    <!-- Collision -->
    <collision>
      <geometry>
        <mesh filename="package://so100_description/meshes/so100/Lower_Arm.stl"/>
      </geometry>
    </collision>

    <collision>
      <geometry>
        <mesh filename="package://so100_description/meshes/so100/Lower_Arm_Motor.stl"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.147968"/>
      <origin
        xyz="-0.00339604 0.00137796 0.0768007"
        rpy="0 0 0"/>
      <inertia
        ixx="0.000138803"
        ixy="0"
        ixz="0"
        iyy="0.000107748"
        iyz="0"
        izz="4.84242e-05"/>
    </inertial>

  </link>


  <!-- ========================================================= -->
  <!-- ELBOW FLEX                                                -->
  <!-- ========================================================= -->

  <joint name="elbow_flex" type="revolute">

    <parent link="upper_arm"/>
    <child link="lower_arm"/>

    <origin
      xyz="0 0.11257 0.028"
      rpy="1.57079 0 0"/>

    <axis xyz="1 0 0"/>

    <limit
      lower="-3.14158"
      upper="0"
      effort="35"
      velocity="1"/>

  </joint>


  <!-- ========================================================= -->
  <!-- WRIST                                                      -->
  <!-- ========================================================= -->

  <link name="wrist">

    <!-- Wrist body -->
    <visual>
      <geometry>
        <mesh filename="package://so100_description/meshes/so100/Wrist_Pitch_Roll.stl"/>
      </geometry>
      <material name="so100_gray"/>
    </visual>

    <!-- Wrist motor -->
    <visual>
      <geometry>
        <mesh filename="package://so100_description/meshes/so100/Wrist_Pitch_Roll_Motor.stl"/>
      </geometry>
      <material name="so100_dark"/>
    </visual>

    <!-- Collision -->
    <collision>
      <geometry>
        <mesh filename="package://so100_description/meshes/so100/Wrist_Pitch_Roll.stl"/>
      </geometry>
    </collision>

    <collision>
      <geometry>
        <mesh filename="package://so100_description/meshes/so100/Wrist_Pitch_Roll_Motor.stl"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.0661321"/>
      <origin
        xyz="-0.00852653 -0.0352279 -2.34622e-05"
        rpy="0 0 0"/>
      <inertia
        ixx="3.45403e-05"
        ixy="0"
        ixz="0"
        iyy="2.39041e-05"
        iyz="0"
        izz="1.94704e-05"/>
    </inertial>

  </link>


  <!-- ========================================================= -->
  <!-- WRIST FLEX                                                 -->
  <!-- ========================================================= -->

  <joint name="wrist_flex" type="revolute">

    <parent link="lower_arm"/>
    <child link="wrist"/>

    <origin
      xyz="0 0.0052 0.1349"
      rpy="-1 0 0"/>

    <axis xyz="1 0 0"/>

    <limit
      lower="-2.5"
      upper="1.2"
      effort="35"
      velocity="1"/>

  </joint>


  <!-- ========================================================= -->
  <!-- GRIPPER HOUSING                                            -->
  <!-- ========================================================= -->

  <link name="gripper">

    <!-- Fixed jaw body -->
    <visual>
      <geometry>
        <mesh filename="package://so100_description/meshes/so100/Fixed_Jaw.stl"/>
      </geometry>
      <material name="so100_gray"/>
    </visual>

    <!-- Fixed jaw motor -->
    <visual>
      <geometry>
        <mesh filename="package://so100_description/meshes/so100/Fixed_Jaw_Motor.stl"/>
      </geometry>
      <material name="so100_dark"/>
    </visual>

    <!-- Collision -->
    <collision>
      <geometry>
        <mesh filename="package://so100_description/meshes/so100/Fixed_Jaw.stl"/>
      </geometry>
    </collision>

    <collision>
      <geometry>
        <mesh filename="package://so100_description/meshes/so100/Fixed_Jaw_Motor.stl"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.0929859"/>
      <origin
        xyz="0.00552377 -0.0280167 0.000483583"
        rpy="0 0 0"/>
      <inertia
        ixx="5.03136e-05"
        ixy="0"
        ixz="0"
        iyy="4.64098e-05"
        iyz="0"
        izz="2.72961e-05"/>
    </inertial>

  </link>


  <!-- ========================================================= -->
  <!-- WRIST ROLL                                                 -->
  <!-- ========================================================= -->

  <joint name="wrist_roll" type="revolute">

    <parent link="wrist"/>
    <child link="gripper"/>

    <origin
      xyz="0 -0.0601 0"
      rpy="0 1.57079 0"/>

    <axis xyz="0 1 0"/>

    <limit
      lower="-3.14158"
      upper="3.14158"
      effort="35"
      velocity="1"/>

  </joint>


  <!-- ========================================================= -->
  <!-- MOVING JAW                                                 -->
  <!-- ========================================================= -->

  <link name="jaw">

    <visual>
      <geometry>
        <mesh filename="package://so100_description/meshes/so100/Moving_Jaw.stl"/>
      </geometry>
      <material name="so100_gray"/>
    </visual>

    <collision>
      <geometry>
        <mesh filename="package://so100_description/meshes/so100/Moving_Jaw.stl"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.0202444"/>
      <origin
        xyz="-0.00161745 -0.0303473 0.000449646"
        rpy="0 0 0"/>
      <inertia
        ixx="1.11265e-05"
        ixy="0"
        ixz="0"
        iyy="8.99651e-06"
        iyz="0"
        izz="2.99548e-06"/>
    </inertial>

  </link>


  <!-- ========================================================= -->
  <!-- GRIPPER                                                   -->
  <!-- ========================================================= -->

  <joint name="gripper" type="revolute">

    <parent link="gripper"/>
    <child link="jaw"/>

    <origin
      xyz="-0.0202 -0.0244 0"
      rpy="0 3.14158 0"/>

    <axis xyz="0 0 1"/>

    <limit
      lower="-0.2"
      upper="2.0"
      effort="35"
      velocity="1"/>

  </joint>

</robot>
